+    else:  # ~180 deg: axis from the symmetric part
+        B = (Re + np.eye(3)) / 2
+        ax = B[:, np.argmax(np.diag(B))]; eo = ax / np.linalg.norm(ax) * np.pi
     return np.concatenate([ep, eo])
 
