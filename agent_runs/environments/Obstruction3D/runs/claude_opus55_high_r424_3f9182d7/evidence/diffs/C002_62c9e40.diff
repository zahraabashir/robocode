+import numpy as np, json, os
+from kin import fk, ik, down_R
+F = ['joint_%d'%i for i in range(1,8)]
+CFG=json.load(open(os.path.join(os.path.dirname(os.path.abspath(__file__)),'cfg.json')))
+class GeneratedApproach:
+    def __init__(self, action_space, observation_space, primitives): pass
+    def reset(self, state, info):
+        self.t=0
+    def get_action(self, s):
+        r=s.get_object_from_name('robot')
+        tb=s.get_object_from_name(CFG.get('obj','target_block'))
+        q=np.array([s.get(r,f) for f in F]); base=(s.get(r,'pos_base_x'),s.get(r,'pos_base_y'),s.get(r,'pos_base_rot'))
+        bx,by,bz=[s.get(tb,f) for f in ['pose_x','pose_y','pose_z']]
+        self.t+=1
+        a=np.zeros(11,dtype=np.float32)
+        qt,ok=ik(base,q,np.array([bx+CFG['dx'],by+CFG['dy'],bz+CFG['dz']]),down_R(CFG['yaw']))
+        a[3:10]=np.clip(qt-q,-0.19,0.19); return a
