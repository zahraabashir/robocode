diff --git a/probe_release.py b/probe_release.py
new file mode 100644
index 0000000..395d16c
--- /dev/null
+++ b/probe_release.py
@@ -0,0 +1,14 @@
+from env_client import make_env
+from kin import *
+E=make_env()
+for lift in [0,.001,.003,.005,.01,.02]:
+ s,_=E.reset(seed=0);r=s.get_object_from_name('robot');b=s.get_object_from_name('target_block');fs=['joint_'+str(i) for i in range(1,8)]
+ def vec(s):return np.array([s.get(r,f) for f in fs])
+ x,y,z=[s.get(b,'pose_'+f) for f in 'xyz']
+ for zt in [.32]*15+list(np.arange(.32,.14,-.005)):
+  q=ik(x,zt);a=np.zeros(11,dtype=np.float32);a[3:10]=np.clip(q-vec(s),-.12,.12);a[1]=np.clip(y-.001-s.get(r,'pos_base_y'),-.12,.12);a[10]=-1;s,*_=E.step(a)
+  if s.get(r,'grasp_active'):break
+ q=ik(x,zt+lift);a=np.zeros(11,dtype=np.float32);a[3:10]=np.clip(q-vec(s),-.12,.12);s,*_=E.step(a)
+ before=s.get(b,'pose_z');a[:]=0;a[10]=1;s,*_=E.step(a)
+ print('RELEASE',lift,'beforez',before,'afterz',s.get(b,'pose_z'),'held',s.get(r,'grasp_active'),'finger',s.get(r,'finger_state'),flush=True)
+E.close()
