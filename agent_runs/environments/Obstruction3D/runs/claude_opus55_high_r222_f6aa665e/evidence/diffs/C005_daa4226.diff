+for yaw in [0,np.pi/2]:
+  for z in [0.23,0.40]:
+    r=[]
+    for x,y in pts:
+        s=np.array([np.arctan2(y,x),0.3,3.14,-2.0,0,0.9,1.57])
+        e=min(ik(s,np.array([x,y,z]),down_R(yaw),(0,0,0))[1], ik(q0,np.array([x,y,z]),down_R(yaw),(0,0,0))[1])
+        r.append("%.0e"%e)
+    print(round(yaw,2),z,r,flush=True)
