+    def _req_z(self, boxes, xy, held, hb):
+        top = TABLE_TOP + 0.03
+        rad = 0.08
+        if held is not None:
+            ex, ey = self._extent_xy(boxes[held])
+            rad = max(rad, np.hypot(ex, ey) + 0.02)
+        for n, b in boxes.items():
+            if b["g"] > 0.5 or n == held:
+                continue
+            ex, ey = self._extent_xy(b)
+            if np.hypot(xy[0] - b["x"], xy[1] - b["y"]) > rad + np.hypot(ex, ey):
+                continue
+            top = max(top, b["z"] + b["hz"])
+        return top + SAFE_CLR + hb + FINGER
+
+    def _joint_plan(self, state, seg):
+        q = self._q(state)
+        base = self._base(state)
+        goal, yaw = seg[1], seg[2]
+        Tw = self._ee_world(q, base)
+        Rt = down_R(yaw) if yaw is not None else down_R(_yaw_of(Tw[:3, :3]))
+        boxes = self._boxes(state)
+        held = self._held(boxes)
+        hb = 0.0
+        if held is not None:
+            b = boxes[held]
+            hb = max(0.0, (Tw[2, 3] - FINGER) - (b["z"] - b["hz"]))
+        best = None
+        for sd in (q, self.q_nom, self.q_home):
+            qg, err = self._ik_world(sd, goal, Rt, base, iters=150)
+            if err > 1e-4:
+                continue
+            dqm = np.max(np.abs(qg - q))
+            if best is None or dqm < best[0]:
+                best = (dqm, qg)
+        if best is None:
+            return False
+        qg = best[1]
+        for sv in np.linspace(0.0, 1.0, 13)[1:-1]:
+            qs = q + sv * (qg - q)
+            T = self._ee_world(qs, base)
+            if T[2, 2] > -0.9:
+                return False
+            if T[2, 3] < self._req_z(boxes, T[:2, 3], held, hb) - 0.005:
+                return False
+        return qg
+
     def _handle_reject(self, state):
         seg = self.cur
         tag = seg[3] if (seg[0] == "move" and len(seg) > 3) else None
