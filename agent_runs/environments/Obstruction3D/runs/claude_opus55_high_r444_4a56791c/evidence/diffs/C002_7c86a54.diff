diff --git a/calib1.py b/calib1.py
new file mode 100644
index 0000000..8afe51f
--- /dev/null
+++ b/calib1.py
@@ -0,0 +1,20 @@
+import sys; YAW=float(sys.argv[1])
+from env_client import make_env
+import numpy as np, kin
+from common import *
+env = make_env()
+obs, info = env.reset(seed=0)
+b = objd(obs,'target_block'); print(b)
+base = getbase(obs); q = getq(obs)
+p = np.array([b['pose_x'], b['pose_y'], 0.40])
+for z in np.arange(0.40, 0.0, -0.005):
+    p[2]=z
+    qt, ok = kin.ik(base, getq(obs), p, kin.topdown_R(YAW))
+    obs, blocked = move_to(env, obs, qt)
+    if blocked: print('blocked at', z); break
+    a=np.zeros(11,dtype=np.float32); a[10]=-1
+    obs,*_ = env.step(a)
+    R=robot(obs)
+    g=obs.get(R,'grasp_active'); fs=obs.get(R,'finger_state')
+    if g or fs: print(round(z,3), 'grasp', g, fs, [round(obs.get(R,f),4) for f in ['grasp_tf_x','grasp_tf_y','grasp_tf_z','grasp_tf_qx','grasp_tf_qy','grasp_tf_qz','grasp_tf_qw']])
+    a[10]=1; obs,*_=env.step(a)
diff --git a/calib2.py b/calib2.py
new file mode 100644
index 0000000..6a34cde
--- /dev/null
+++ b/calib2.py
@@ -0,0 +1,15 @@
+import sys
+from env_client import make_env
+import numpy as np, kin
+from common import *
+env = make_env()
+obs, info = env.reset(seed=0)
+base = getbase(obs)
+for (x,y) in [(0.2,-0.1),(0.3,-0.2),(0.15,0.0)]:
+    p = np.array([x,y,0.40])
+    for z in np.arange(0.40, -0.2, -0.005):
+        p[2]=z
+        qt, ok = kin.ik(base, getq(obs), p, kin.topdown_R(0))
+        obs, blocked = move_to(env, obs, qt)
+        if blocked or not ok: print(x,y,'blocked at', round(z,3), ok); break
+    p[2]=0.4; qt, ok = kin.ik(base, getq(obs), p, kin.topdown_R(0)); obs,_=move_to(env,obs,qt)
