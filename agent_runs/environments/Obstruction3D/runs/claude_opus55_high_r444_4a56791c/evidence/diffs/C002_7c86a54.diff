diff --git a/common.py b/common.py
new file mode 100644
index 0000000..c78ef35
--- /dev/null
+++ b/common.py
@@ -0,0 +1,22 @@
+import numpy as np, kin
+JN = [f'joint_{i}' for i in range(1,8)]
+def robot(obs): return obs.get_object_from_name('robot')
+def getq(obs):
+    R = robot(obs); return np.array([obs.get(R,f) for f in JN])
+def getbase(obs):
+    R = robot(obs); return np.array([obs.get(R,f) for f in ['pos_base_x','pos_base_y','pos_base_rot']])
+def objd(obs, n):
+    o = obs.get_object_from_name(n)
+    return {f: obs.get(o,f) for f in ['pose_x','pose_y','pose_z','half_extent_x','half_extent_y','half_extent_z','grasp_active','pose_qx','pose_qy','pose_qz','pose_qw']}
+def move_to(env, obs, qt, grip=0.0, maxd=0.2):
+    """step joints toward qt; returns obs, blocked flag"""
+    while True:
+        q = getq(obs)
+        d = np.array(qt) - q
+        d = (d + np.pi) % (2*np.pi) - np.pi
+        if np.max(np.abs(d)) < 1e-6: return obs, False
+        s = max(1.0, np.max(np.abs(d))/maxd)
+        a = np.zeros(11, dtype=np.float32); a[3:10] = d/s; a[10]=grip
+        obs, r, t, tr, info = env.step(a)
+        if np.max(np.abs(getq(obs)-q)) < 1e-7: return obs, True
+        if t: return obs, False
diff --git a/dbg/approach.py b/dbg/approach.py
new file mode 100644
index 0000000..6d553df
--- /dev/null
+++ b/dbg/approach.py
@@ -0,0 +1,26 @@
+import numpy as np
+import kin
+JN = [f'joint_{i}' for i in range(1,8)]
+class GeneratedApproach:
+    def __init__(self, action_space, observation_space, primitives): pass
+    def reset(self, state, info):
+        R = state.get_object_from_name('robot'); self.R=R
+        b = state.get_object_from_name('target_block')
+        self.base = np.array([state.get(R,f) for f in ['pos_base_x','pos_base_y','pos_base_rot']])
+        q = np.array([state.get(R,f) for f in JN])
+        bx, by = state.get(b,'pose_x'), state.get(b,'pose_y')
+        self.targets=[]
+        for z in [0.35, 0.3, 0.26, 0.235]:
+            q,_ = kin.ik(self.base, q, np.array([bx,by,z]), kin.topdown_R(0)); self.targets.append(q)
+        self.t=0
+    def get_action(self, state):
+        q = np.array([state.get(self.R,f) for f in JN])
+        a = np.zeros(11, dtype=np.float32)
+        while self.targets:
+            d = self.targets[0]-q
+            if np.max(np.abs(d))<1e-5: self.targets.pop(0); continue
+            a[3:10] = np.clip(d,-0.2,0.2); return a
+        self.t+=1
+        a[10] = -1 if self.t<5 else 0
+        if self.t>=5: a[5]=0.0; a[4]=-0.05
+        return a
