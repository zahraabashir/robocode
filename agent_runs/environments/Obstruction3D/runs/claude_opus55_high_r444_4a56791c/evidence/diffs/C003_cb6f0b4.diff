@@ -0,0 +1,17 @@
+from env_client import make_env
+import numpy as np
+from common import *
+env = make_env()
+mins={}; maxs={}; counts=[]; rots=0; bases=set()
+for s in range(60):
+    obs,info=env.reset(seed=s)
