+
+    def _set_path(self, state, wps, yaw, final_grip=0.0, res=0.01, flip=False, rot_start=0):
+        """Cartesian waypoints -> dense joint path (IK warm-started).
+        Yaw is interpolated from the current tool yaw over all but the last segment."""
+        q = self._x(state)
+        base = self._base(state)
+        T0 = wb_fk(q)
+        cur = T0[:3, 3]
+        y0 = np.arctan2(T0[1, 0], T0[0, 0])
+        dy = _wrap(yaw - y0)
+        if flip and abs(dy) > np.pi / 2:
+            dy = dy - np.sign(dy) * np.pi
+        yaw = y0 + dy
+        pts = [cur]
+        for w in wps:
+            pts.append(np.asarray(w, dtype=float))
+        seg = [np.linalg.norm(pts[i + 1] - pts[i]) for i in range(len(wps))]
+        if len(seg) - 1 <= rot_start:
+            rot_start = 0
+        rot0 = sum(seg[:rot_start])
+        rot_len = sum(seg[rot_start:-1]) if len(seg) > 1 and sum(seg[rot_start:-1]) > 0.02 else sum(seg[rot_start:])
+        rot_len = max(rot_len, 1e-6)
+        path = []
+        self.corners = set()
+        qc = q.copy()
+        travelled = 0.0
+        for i, w in enumerate(wps):
+            w = pts[i + 1]
+            d = seg[i]
+            n = max(1, int(np.ceil(d / res)), int(np.ceil(abs(dy) * min(d, rot_len) / rot_len / 0.04)))
+            for k in range(1, n + 1):
+                pt = cur + (w - cur) * k / n
+                f = min(1.0, max(0.0, travelled + d * k / n - rot0) / rot_len)
+                qn, ok = self._ik(qc, pt, down_R(y0 + f * dy))
+                qn = qc + _wrap(qn - qc)
+                path.append(qn)
+                qc = qn
+            travelled += d
+            self.corners.add(len(path) - 1)
+            cur = w
+        self.qpath = path
+        self.popped = 0
+        self.wp_yaw = yaw
+        self.final_grip = final_grip
+        self.travel_grip = 1.0 if final_grip < 0 else 0.0
+        self.stuck = 0
