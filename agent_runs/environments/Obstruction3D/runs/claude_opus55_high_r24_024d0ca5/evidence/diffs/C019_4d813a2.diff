+        return scored
+
+    def _select_task(self, state):
+        """Reorder tasks so the front one is graspable; add blockers if needed."""
+        for _ in range(len(self.names)):
+            name, kind = self.tasks[0]
+            f = self.fails.get(name, 0)
+            sc = self._yaw_scores(state, name, kind)
+            if sc[0][0] > 0.002 and f < 4:
+                return
+            # try another pending clear task that is more graspable
+            best = None
+            for t in self.tasks:
+                if t[1] != 'clear' or t[0] == name:
+                    continue
+                s2 = self._yaw_scores(state, t[0], 'clear')[0][0] - 0.01 * self.fails.get(t[0], 0)
+                if best is None or s2 > best[0]:
+                    best = (s2, t)
+            if best is not None and best[0] > sc[0][0] - 0.01 * f + 0.001:
+                self.tasks.remove(best[1])
+                self.tasks.insert(0, best[1])
+                continue
+            # add the obstruction blocking the fingers as a new task
+            blk = sc[0][2]
+            if (blk is not None and blk.startswith('obstruction')
+                    and all(t[0] != blk for t in self.tasks)
+                    and self.blk_moves.get(blk, 0) < 2
+                    and self._yaw_scores(state, blk, 'clear')[0][0] > 0.002):
+                self.blk_moves[blk] = self.blk_moves.get(blk, 0) + 1
+                self.tasks.insert(0, (blk, 'clear'))
+                continue
+            return
+
+    def _grasp_z(self, p, h):
+        lo = p[2] - h[2] + 0.045
+        hi = p[2] + h[2] + 0.032
+        return 0.5 * (lo + hi) if hi > lo else hi - 0.001
+
+    def _free_spot(self, state, name, yaw, hold_off):
+        """Pick a table spot clear of region/other objects (object + fingers)."""
+        p0, _, _ = self._pose(state, name)
+        c0, h, _, _ = self._box(state, name)
+        others = []
+        for n in self.names:
+            if n == name:
+                continue
+            others.append(self._box(state, n))
+        rp, rh = self.region
+        tip = self.table_z + 0.001 + hold_off - FINGER_DOWN
+        best, best_score = None, 1e9
+        fb, fb_score = None, -1e9
+        for x in np.linspace(0.2, 0.5, 16):
+            for y in np.linspace(-0.34, 0.34, 35):
+                c = np.array([x, y])
+                clear = _gap(c, h, rp[:2], rh[:2]) - 0.03
+                fbs = _finger_boxes(c, yaw)
+                for oc, oh, bot, top in others:
+                    clear = min(clear, _gap(c, h, oc, oh) - 0.02)
+                    if top > tip - 0.002:
+                        for fc, fh in fbs:
+                            clear = min(clear, _gap(fc, fh, oc, oh) - 0.008)
+                if clear > fb_score:
+                    fb, fb_score = c, clear
+                if clear >= 0:
+                    score = np.linalg.norm(c - p0[:2])
+                    if score < best_score:
+                        best, best_score = c, score
