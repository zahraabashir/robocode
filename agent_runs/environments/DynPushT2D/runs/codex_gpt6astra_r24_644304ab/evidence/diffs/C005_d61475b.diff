diff --git a/probe_com.py b/probe_com.py
new file mode 100644
index 0000000..c9d7a26
--- /dev/null
+++ b/probe_com.py
@@ -0,0 +1,19 @@
+import numpy as np
+from env_client import make_env
+
+def R(t):return np.array([[np.cos(t),-np.sin(t)],[np.sin(t),np.cos(t)]])
+for xx in [-.3,.3]:
+ e=make_env();s,_=e.reset(seed=1);p=s[:2].copy();a=s[2];rot=R(a);count=0
+ # Approach upper face through upper free halfplane.
+ target=p+rot@np.array([xx,.5])
+ for k in range(70):
+  d=target-s[16:18]
+  if np.linalg.norm(d)<.001:break
+  s,*_=e.step(np.clip(d,-.049,.049));count+=1
+ print('START',xx,count,'block',s[:3], 'localrobot',rot.T@(s[16:18]-s[:2]),flush=True)
+ for k in range(25):
+  old=s.copy();a0=old[2];s,*_=e.step(R(a0)@np.array([0.,-.02]));count+=1
+  dp=R(a0).T@(s[:2]-old[:2]);da=s[2]-old[2];q=R(a0).T@(old[16:18]-old[:2]);
+  if abs(da)>1e-7:
+   print('PUSH',xx,k,'q',q,'dp',dp,'da',da,'c_y',dp[0]/da,'I',-q[0]*dp[1]/da,flush=True)
+ print('COUNT',count,flush=True);e.close()
diff --git a/probe_geometry.py b/probe_geometry.py
new file mode 100644
index 0000000..d5afb53
--- /dev/null
+++ b/probe_geometry.py
@@ -0,0 +1,16 @@
+import numpy as np
+from env_client import make_env
+for xx in [0,.3,-.3]:
+ e=make_env();o,_=e.reset(seed=0);p=o[:2].copy();a=o[2];R=np.array([[np.cos(a),-np.sin(a)],[np.sin(a),np.cos(a)]])
+ def go(t):
+  global o
+  for _ in range(150):
+   d=t-o[16:18]
+   if np.linalg.norm(d)<1e-5:break
+   o,*_=e.step(np.clip(d,-.049,.049).astype(np.float32))
+ go(p+R@np.array([xx,.8]));print('start',xx,(R.T@(o[16:18]-p)).tolist(),o[:3].tolist())
+ for i in range(100):
+  bef=o.copy();o,*_=e.step((R@np.array([0.,-.01])).astype(np.float32))
+  if np.linalg.norm(o[:2]-p)>1e-5 or abs(o[2]-a)>1e-5:
+   print('contact',xx,'robot before',(R.T@(bef[16:18]-p)).tolist(),'after',(R.T@(o[16:18]-p)).tolist(),'object',o[:3].tolist());break
+ e.close()
diff --git a/probe_geometry2.py b/probe_geometry2.py
new file mode 100644
index 0000000..1a8da9e
--- /dev/null
+++ b/probe_geometry2.py
@@ -0,0 +1,17 @@
+import numpy as np
+from env_client import make_env
+for target, direction in [([0,-1.45],[0,.01]),([-.8,-.5],[.01,0]),([-.8,-.065],[.01,0])]:
+ e=make_env();o,_=e.reset(seed=0);p=o[:2].copy();a=o[2];R=np.array([[np.cos(a),-np.sin(a)],[np.sin(a),np.cos(a)]])
+ def go(q):
+  global o
+  t=p+R@np.array(q)
+  for _ in range(150):
+   d=t-o[16:18]
+   if np.linalg.norm(d)<1e-5:break
+   o,*_=e.step(np.clip(d,-.049,.049))
+ go([-.85,.5]);go([-.85,target[1]]);go(target);print('start',target,(R.T@(o[16:18]-p)).tolist(),o[:3].tolist())
+ for i in range(150):
+  bef=o.copy();o,*_=e.step(R@np.array(direction))
+  if np.linalg.norm(o[:2]-p)>1e-5 or abs(o[2]-a)>1e-5:
+   print('contact','robot before',(R.T@(bef[16:18]-p)).tolist(),'after',(R.T@(o[16:18]-p)).tolist(),'object',o[:3].tolist());break
+ e.close()
