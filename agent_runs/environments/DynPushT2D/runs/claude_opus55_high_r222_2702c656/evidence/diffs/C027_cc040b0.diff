+for t in range(N):
+    if t==N-1:
+        B=Block(obs); rp=obs[16:18].copy()
+        for i in range(6):
+            r=ap._act(obs,B,rp); print(ap.mode, ap.push[0], 'goal',ap.push_goal, 'act', r, 'banned', ap.banned, ap.push_steps)
