+    def pick_trans_la(self, B, cands, err, smax):
+        best, bc = None, 1e18
+        for s, pr in cands:
+            if s <= 0.004:
+                continue
+            name, p, n, k, tq = pr
+            nw = B.dir_world(n)
+            d = min(self._dmax.get(name, s), float(nw @ err))
+            if d <= 0.004:
+                continue
+            path1 = self.path_len(B, self.rp, B.to_world(p - n * (R_ROBOT + 0.04)))
+            c1 = (path1 + d + 0.04) / 0.05 + (6.0 if k == 'f' else 0.0) + 2.0
+            p1 = B.p + nw * d
+            B1 = B.moved(p1, B.th)
+            e1 = err - nw * d
+            rob1 = B1.to_world(p - n * R_ROBOT)
+            if np.linalg.norm(e1) < 0.015:
+                c2 = 0.0
+            else:
+                c2 = self.kres * np.linalg.norm(e1) / 0.05 + self.kpush
+                for s2, pr2 in cands:
+                    name2, p2, n2, k2, _ = pr2
+                    nw2 = B1.dir_world(n2)
+                    d2 = float(nw2 @ e1)
+                    if d2 <= 0.004 or name2 == name:
+                        continue
+                    path2 = self.path_len(B1, rob1, B1.to_world(p2 - n2 * (R_ROBOT + 0.04)))
+                    e2 = np.linalg.norm(e1 - nw2 * d2)
+                    cc = (path2 + d2 + 0.04) / 0.05 + (6.0 if k2 == 'f' else 0.0) + 2.0
+                    if e2 > 0.015:
+                        cc += self.kres * e2 / 0.05 + self.kpush
+                    c2 = min(c2, cc)
+            if c1 + c2 < bc:
+                bc, best = c1 + c2, pr
+        if best is None:
+            return max(cands, key=lambda c: c[0])[1]
+        return best
+
