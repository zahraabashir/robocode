@@ -0,0 +1,32 @@
+from env_client import make_env
+import numpy as np, math, json
+
+def move(e,s,target):
+ for _ in range(140):
+  delta=target-s[16:18]
+  if np.linalg.norm(delta)<.003: break
+  s,*_=e.step(np.clip(delta,-.049,.049))
+ return s
+
+out=[]
+for ang in np.linspace(-math.pi,math.pi,12,endpoint=False):
+ e=make_env();s,_=e.reset(seed=0);c=s[:2].copy();a0=math.atan2(*(s[16:18]-c)[::-1]);a=ang+s[2];rad=1.05
+ # radial out then follow short arc around body
+ s=move(e,s,c+rad*np.array([math.cos(a0),math.sin(a0)]))
+ da=(a-a0+math.pi)%(2*math.pi)-math.pi
+ for aa in np.linspace(a0,a0+da,int(abs(da)/.12)+2)[1:]:
+  s=move(e,s,c+rad*np.array([math.cos(aa),math.sin(aa)]))
+ v=-np.array([math.cos(a),math.sin(a)])
+ hit=None;hist=[]
+ for k in range(70):
+  old=s.copy();s,*_=e.step(v*.018)
+  ds=s[:3]-old[:3]
+  if np.linalg.norm(ds)>.0001:
+   if hit is None:hit=(s[16:18]-c).tolist()
+   hist.append({'pos':s[:6].tolist(),'dr':ds.tolist(),'r':s[16:18].tolist()})
+   if len(hist)>=10:break
+ stop=[]
+ for k in range(4):s,*_=e.step(np.zeros(2));stop.append(s[:6].tolist())
+ result=dict(angle=float(ang),hit=hit,hist=hist,stop=stop)
+ out.append(result);print(json.dumps(result),flush=True);e.close()
+open('dynamics_results.json','w').write(json.dumps(out))
