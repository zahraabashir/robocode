diff --git a/approach.py b/approach.py
index a532507..a8d63c9 100644
--- a/approach.py
+++ b/approach.py
@@ -79,11 +79,14 @@ class GeneratedApproach:
   # Prevent planned pushes from driving a nearby block vertex into a wall.
   vertices=self.geometry(s,0)
   world=vertices@R.T+s[:2]
+  goal_vertices=vertices@rot(s[31]).T+s[29:31]
+  wall_low=np.minimum(.15,np.maximum(.007,goal_vertices.min(axis=0)-.03))
+  wall_high=np.maximum(4.85,np.minimum(4.993,goal_vertices.max(axis=0)+.03))
   constraints=[];bounds=[]
   for axis in range(2):
    for sign in [-1.,1.]:
     i=int(np.argmax(sign*world[:,axis]));position=world[i,axis]
-    distance=(4.85-position) if sign>0 else (position-.15)
+    distance=(wall_high[axis]-position) if sign>0 else (position-wall_low[axis])
     if distance<.30:
      rr=vertices[i]-c
      B=R@(np.eye(2)+np.outer(np.array([-rr[1],rr[0]]),z))
