+    pb,dp=probe(s,[x,-0.3],[0,1]) if False else (None,None)
+  for y in [-0.3,-0.6]:
+    pb,dp=probe(s,[1.0,y],[-1,0]); print('seed',s,'stem side y',y,pb,dp)
+  pb,dp=probe(s,[1.2,0.0],[-1,0]); print('seed',s,'bar end +x',pb,dp)
