+from env_client import make_env
+import numpy as np
+for feature,index,d in [('x',0,-.05),('x',0,.05),('y',1,.05)]:
+ e=make_env();s,i=e.reset(seed=0);r=s.get_object_from_name('robot')
+ for delta in [d,d/10,d/100,d/1000]:
+  for j in range(40):
+   a=np.zeros(5,dtype=np.float32);a[index]=delta;s,*_=e.step(a)
+ print('base bound',feature,d,s.get(r,feature));e.close()
+for dy in [-.05,-.01]:
+ e=make_env();s,i=e.reset(seed=0);r=s.get_object_from_name('robot');b=s.get_object_from_name('target_block')
+ x=s.get(b,'x')+s.get(b,'width')/2
+ for j in range(10):s,*_=e.step(np.array([np.clip(x-s.get(r,'x'),-.05,.05),0,0,.1,0],dtype=np.float32))
+ for j in range(100):s,*_=e.step(np.array([0,dy,0,0,1],dtype=np.float32))
+ by=s.get(b,'y');ry=s.get(r,'y');s,*_=e.step(np.array([0,.05,0,0,1],dtype=np.float32))
+ print('descend',dy,'stopped',ry,'target_top',by+s.get(b,'height'),'grasp_dy',s.get(b,'y')-by);e.close()
diff --git a/probe_release.py b/probe_release.py
new file mode 100644
index 0000000..d47e87b
--- /dev/null
+++ b/probe_release.py
@@ -0,0 +1,30 @@
+from env_client import make_env
+import numpy as np
+
+def run(release):
+ e=make_env();s,_=e.reset(seed=0);r=s.get_object_from_name('robot');o=s.get_object_from_name('obstruction1')
+ def step(a):
+  nonlocal s
+  s,_,_,_,_=e.step(np.array(a,dtype=np.float32))
+ def pos(): return [round(s.get(z,f),4) for z in [r,o] for f in ['x','y']]
+ def move(x,y,v=1):
+  for _ in range(100):
+   dx=x-s.get(r,'x');dy=y-s.get(r,'y')
+   if max(abs(dx),abs(dy))<1e-5:break
+   old=pos();step([np.clip(dx,-.05,.05),np.clip(dy,-.05,.05),0,0,v])
+   if pos()==old:break
+ x=s.get(o,'x')+s.get(o,'width')/2
+ step([0,0,0,.1,0])
+ move(x,s.get(r,'y'),0)
+ move(x,s.get(o,'y')+s.get(o,'height')+.205)
+ print('CONTACT',pos(),'arm',s.get(r,'arm_joint'))
+ move(x,s.get(r,'y')+.2)
+ print('LIFT',pos())
+ if release:
+  step([0,0,0,0,0]); print('RELEASE',pos())
+  for i in range(4):step([-.05,0,0,0,0]);print('AFTER',i,pos())
+ else:
+  move(.85,s.get(r,'y')); move(.85,.4963); print('LOWER_ON_OBSTACLE',pos()); move(.85,.6963); move(1.8,s.get(r,'y'));print('RIGHT_BOUND',pos())
+  for i in range(5):step([.05,0,0,0,1]);print('RIGHT_MORE',pos())
+ e.close()
+run(True);run(False)
