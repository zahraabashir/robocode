+    global obs
+    obs,*_ = env.step(np.array(a,dtype=np.float32))
+tx = 0.4976+0.097; gy = 0.1+0.159+0.205+0.0015
+step([0,0,0,0.1,0])
+for i in range(40):
+    dx=tx-R()[0]; dy=gy-R()[1]; s=min(1,0.05/max(abs(dx),abs(dy),1e-9))
