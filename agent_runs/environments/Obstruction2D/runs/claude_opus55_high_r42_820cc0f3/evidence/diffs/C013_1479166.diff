         carried = (-gx_rel, b["w"] - gx_rel, -gy_rel, b["h"] - gy_rel)
         return pts, carried
@@ -380,7 +381,7 @@ class GeneratedApproach:
         gx_rel = gx - tgt["x"]
         if is_block:
             dest_x = self.block_dest
-            dest_y = FLOOR + 0.012 - PLACE_GAP
+            dest_y = FLOOR + BLOCK_Z - PLACE_GAP
         else:
             b = self.block
             bgx = b["x"] + b["w"] / 2
