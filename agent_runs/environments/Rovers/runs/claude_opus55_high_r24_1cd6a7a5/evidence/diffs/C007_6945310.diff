+    def _los_clear(self, p, q):
+        sc = self.sc
+        if np.linalg.norm(sc.lpos - p) > SEND_R:
+            return False
+        if self._seg_dist(q, p, sc.lpos) < 0.29:
+            return False
+        for pc in self._pillars():
+            if self._seg_dist(np.array(pc), p, sc.lpos) < 0.14:
+                return False
+        return True
+
+    def _future_los(self, state, i, k):
+        """Will a send facing any direction be possible later on my path (after my last task visit)?"""
+        plan = self.plans[i]
+        path = plan["path"]
+        P = self.planners[i]
+        last = max([idx for idx, ts in plan["visits"].items()
+                    if any(not self._task_done(state, t) for t in ts)] + [k])
+        op = self.plans[1 - i]
+        opath = op["path"]
+        ok0 = op["k"]
+        Po = self.planners[1 - i]
+        for idx in range(last, len(path)):
+            q = Po.pos(opath[min(len(opath) - 1, ok0 + (idx - k))])
+            if self._los_clear(P.pos(path[idx]), q):
+                return True
+        return False
