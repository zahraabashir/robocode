+    def _segdist_grid(self, q):
+        """Distance from point q to segment (cell -> lander) for every cell."""
+        L = self.sc.lpos
+        ax, ay = self.X, self.Y
+        bx, by = L[0] - ax, L[1] - ay
+        qx, qy = q[0] - ax, q[1] - ay
+        t = np.clip((qx * bx + qy * by) / np.maximum(bx * bx + by * by, 1e-12), 0.0, 1.0)
+        return np.sqrt((qx - t * bx) ** 2 + (qy - t * by) ** 2)
