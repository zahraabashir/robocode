+r=float(sys.argv[1]); thd=float(sys.argv[2]); s0,s1,ds=map(float,sys.argv[3:6])
+u=(pill-o)/np.linalg.norm(pill-o); n=np.array([-u[1],u[0]])
+goto([(1.0,-1.75),(0.9,-1.75)]); turn(np.deg2rad(thd))
+res=[]
+for s in np.arange(s0,s1+1e-9,ds):
