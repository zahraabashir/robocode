+      e=0
+      for th,d in data.items():
+        c=d*u+rho*np.array([math.cos(th+phi),math.sin(th+phi)])
+        e=max(e,abs(np.linalg.norm(c)-R))
+      best.append((round(e,4),round(R,4),round(rho,4),round(math.degrees(phi))))
+best.sort(); print(best[:6])
