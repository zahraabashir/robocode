+import sys, math, numpy as np
+from env_client import make_env
+from approach import SEL
+env=make_env()
+def trial(seed, rover, x, y, th, other=None, smp=None):
+    obs,_=env.reset(seed=seed)
+    st=env.get_state()
+    R={o.name:o for o in st.get_objects(env.observation_space.get_type('rover'))}
+    S=[o for o in st.get_objects(env.observation_space.get_type('sample'))]
+    r=R[rover]; st.set(r,'x',x); st.set(r,'y',y); st.set(r,'theta',th)
+    if other: o=R[other[0]]; st.set(o,'x',other[1]); st.set(o,'y',other[2])
+    s=S[smp] if smp is not None else S[0]
+    st.set(s,'analyzed_'+rover,1.0)
+    env.set_state(st)
+    a=np.zeros(8,np.float32); a[3]=SEL['none']; a[7]=SEL['none']
+    k=0 if rover=='rover0' else 4
+    a[k+3]=SEL['send']
+    obs,*_=env.step(a)
+    ss=[o for o in obs.get_objects(env.observation_space.get_type('sample'))]
+    return float(obs.get(ss[smp if smp is not None else 0],'received_analysis'))
+if __name__=='__main__':
+    print(trial(549,'rover0',0.975,-2.075,math.pi))
+    print(trial(549,'rover1',-1.175,-1.675,0.0))
+    print(trial(549,'rover0',0.975,-2.075,math.pi, smp=1))
