diff --git a/plancmp2.py b/plancmp2.py
new file mode 100644
index 0000000..9cc2af1
--- /dev/null
+++ b/plancmp2.py
@@ -0,0 +1,12 @@
+import sys
+from env_client import make_env
+import approach, approach_norot
+env=make_env(); tot=[0,0]; fb=0
+for s in range(int(sys.argv[1]),int(sys.argv[2])):
+    obs,info=env.reset(seed=s); out=[]
+    for i,m in enumerate([approach_norot, approach]):
+        ap=m.GeneratedApproach(env.action_space, env.observation_space,{}); ap.reset(obs,info)
+        v=max(len(p) for p in ap.plans.values()); tot[i]+=v; out.append(v)
+    if not ap.rot: fb+=1
+    print(s,out, ap.rot)
+print(tot, 'fallbacks', fb)
diff --git a/plancmp3.py b/plancmp3.py
new file mode 100644
index 0000000..674ab86
--- /dev/null
+++ b/plancmp3.py
@@ -0,0 +1,21 @@
+import sys
+from env_client import make_env
+import approach
+env=make_env(); tot=[0]*6
+for s in range(int(sys.argv[1]),int(sys.argv[2])):
+    obs,info=env.reset(seed=s); out=[]
+    for i,aset in enumerate([[0],[4],[8],[12],[2],[14]]):
+        ap=approach.GeneratedApproach(env.action_space, env.observation_space,{})
+        approach.ROT=True
+        orig=ap._plan
+        ap.reset(obs,info) if False else None
+        # set angset before reset planning
+        ap.__dict__['angset_fixed']=aset
+        oldreset=ap.reset
+        approach_reset=approach.GeneratedApproach.reset
+        def patched_plan(state, ap=ap, aset=aset, orig=orig):
+            ap.angset=aset; return orig(state)
+        ap._plan=patched_plan
+        ap.reset(obs,info)
+        v=max(len(p) for p in ap.plans.values()) if ap.rot else 99; out.append(v)
+    print(s,out, flush=True)
