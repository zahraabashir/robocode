 from env_client import make_env
 import numpy as np
 
-e=make_env();s,i=e.reset(seed=0)
-print('action',e.action_space.low,e.action_space.high)
-def pos(j=0):
- o=s.get_object_from_name('rover'+str(j));return tuple(round(float(s.get(o,f)),4) for f in ('x','y','theta','calibrated','at_home'))
-def act(dx=0,dy=0,op=0,j=0,dt=0):
- global s
- a=np.zeros(8,dtype=np.float32);a[4*j:4*j+4]=[dx,dy,dt,op]
- s,r,t,tr,i=e.step(a);return pos(j)
-print('start',pos())
-print('x input .2',act(.2))
-print('x input 1',act(1))
-print('north',*[act(dy=1) for _ in range(13)])
-print('west',*[act(dx=-1) for _ in range(10)])
-print('north2',*[act(dy=1,op=-.5) for _ in range(8)])
-e.close()
+def trial(y):
+ e=make_env();s,_=e.reset(seed=0);o=s.get_object_from_name('rover0')
+ def p():return np.array([s.get(o,'x'),s.get(o,'y')])
+ def go(target):
+  nonlocal s
+  for k in range(40):
+   q=p();d=np.clip(np.array(target)-q,-.2,.2)
+   if max(abs(d))<1e-5:return
+   a=np.zeros(8);a[:2]=d;s,*_=e.step(a)
+   if np.linalg.norm(p()-q)<1e-7:return
+ go((1.0,y));start=p();go((-.5,y));print('cross',y,'start',start,'end',p())
+ e.close()
+for y in [-2.4,-1.75,-1.5,-1.3,-1.2,-1.0,0,1,1.3,1.5,1.65]:trial(y)
