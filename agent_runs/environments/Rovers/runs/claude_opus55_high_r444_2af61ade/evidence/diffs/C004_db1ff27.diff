new file mode 100644
index 0000000..8bb43dd
--- /dev/null
+++ b/probe_vis_grid.py
@@ -0,0 +1,22 @@
+import sys, json, math, itertools
+import numpy as np
+from probe_vis_model import *
+from probe_vis_lib import E
+sets=[]
+for f in sys.argv[1:]:
+    d=json.load(open(f)); e=E(d['seed'])
+    ob=e.objs()[d['obj']]; obj=(ob['x'],ob['y'],ob['z'])
+    obs=[tuple(e.obs.get(o,k) for k in ['x','y','z','half_x','half_y','half_z']) for o in e.obs if o.type.name=='obstacle']
+    e.close(); sets.append((obj,obs,d['data']))
+def score(**kw):
+    m=0
+    for obj,obs,data in sets:
+        for x,y,th,c in data:
+            m+= (visible(x,y,th,obj,obs,D=9,**kw)!=bool(c))
+    return m
+res=[]
+for a in np.arange(-0.4,0.41,0.05):
+    for b in np.arange(-0.2,0.21,0.05):
+        for zc in list(np.arange(0.25,1.01,0.05)):
+            res.append((score(a=a,b=b,zc=zc),round(a,3),round(b,3),round(zc,3)))
+res.sort(); print(res[:15])
diff --git a/probe_vis_h1.py b/probe_vis_h1.py
new file mode 100644
index 0000000..c2086e5
--- /dev/null
+++ b/probe_vis_h1.py
@@ -0,0 +1,23 @@
+import sys, json, math
+from probe_vis_model import seg_box_hit
+from probe_vis_lib import E
+sets=[]
+for f in sys.argv[1:]:
+    d=json.load(open(f)); e=E(d['seed'])
+    ob=e.objs()[d['obj']]; obj=(ob['x'],ob['y'],ob['z'])
+    obs=[tuple(e.obs.get(o,k) for k in ['x','y','z','half_x','half_y','half_z']) for o in e.obs if o.type.name=='obstacle']
+    e.close(); sets.append((obj,obs,d['data']))
+def vis(x,y,th,obj,obs,a,b,thr,origin_cam):
+    cx=x+a*math.cos(th)-b*math.sin(th); cy=y+a*math.sin(th)+b*math.cos(th)
+    for (px,py,pz,hx,hy,hz) in obs:
+        if abs(px-obj[0])<=hx and abs(py-obj[1])<=hy: continue
+        if seg_box_hit((cx,cy),obj[:2],(px-hx,py-hy),(px+hx,py+hy)):
+            ox,oy=(cx,cy) if origin_cam else (x,y)
+            rel=math.atan2(py-oy,px-ox)-th; rel=(rel+math.pi)%(2*math.pi)-math.pi
+            if abs(rel)<thr: return False
+    return True
+for oc in [True,False]:
+  for a,b in [(-0.087,-0.0125),(0,0)]:
+    for thr in [1.2,1.4,1.5,1.571,1.65,1.75,1.9,2.2,3.2]:
+        m=sum(vis(x,y,th,obj,obs,a,b,thr,oc)!=bool(c) for obj,obs,data in sets for x,y,th,c in data)
+        print(oc,a,b,thr,m)
diff --git a/probe_vis_h2.py b/probe_vis_h2.py
new file mode 100644
index 0000000..adca868
--- /dev/null
+++ b/probe_vis_h2.py
@@ -0,0 +1,29 @@
+import sys, json, math, glob
+from probe_vis_model import seg_box_hit
+from probe_vis_lib import E
+e=E(4); ob=e.objs()['objective2']; obj=(ob['x'],ob['y'],ob['z'])
+obs=[tuple(e.obs.get(o,k) for k in ['x','y','z','half_x','half_y','half_z']) for o in e.obs if o.type.name=='obstacle']; e.close()
+data=json.load(open('probe_vis_d1.json'))['data']
+for f in glob.glob('probe_vis_j_*_0.75.json'): data+=json.load(open(f))
+print(len(data))
+def vis(x,y,th,a,b,thr,mode,infl=0.0):
+    cx=x+a*math.cos(th)-b*math.sin(th); cy=y+a*math.sin(th)+b*math.cos(th)
+    for (px,py,pz,hx,hy,hz) in obs:
+        if abs(px-obj[0])<=hx and abs(py-obj[1])<=hy: continue
+        if seg_box_hit((cx,cy),obj[:2],(px-hx-infl,py-hy-infl),(px+hx+infl,py+hy+infl)):
+            if mode=='obj': tx,ty=obj[0],obj[1]
+            else: tx,ty=px,py
+            rel=math.atan2(ty-cy,tx-cx)-th; rel=(rel+math.pi)%(2*math.pi)-math.pi
+            if abs(rel)<thr: return False
+    return True
+best=[]
+for mode in ['obj','pil']:
+  for a in [-0.06,-0.087,-0.1,-0.12,-0.15]:
+    for b in [-0.0125,0.0]:
+      for thr in [1.45,1.5,1.55,1.6,1.65,1.7,1.75]:
+        m=sum(vis(x,y,th,a,b,thr,mode)!=bool(c) for x,y,th,c in data)
+        best.append((m,mode,a,b,thr))
+best.sort(); print(best[:10])
+mm=[(round(th,2),round(x,3),round(y,3),c) for x,y,th,c in data if vis(x,y,th,-0.1,0.0,1.6,'obj')!=bool(c)]
+mm.sort(); 
+for r in mm: print(r)
diff --git a/probe_vis_i.py b/probe_vis_i.py
new file mode 100644
index 0000000..3ea7c60
--- /dev/null
+++ b/probe_vis_i.py
@@ -0,0 +1,16 @@
+from probe_vis_lib import *
+import sys
+e=E(4)
+x,y=float(sys.argv[1]),float(sys.argv[2]); N=int(sys.argv[3])
+print(e.path(1,[(-1.0,-1.0),(-1.0,y),(x,y)]), e.rs(1))
+s=''
+blocked=[]
+for k in range(N):
+    th=-math.pi+k*2*math.pi/N
+    e.turn(1,th)
+    st=e.rs(1)
+    if abs((st['theta']-th+math.pi)%(2*math.pi)-math.pi)>1e-3: s+='?'; continue
+    e.step(1,0,0,0,'cal'); c=e.rs(1)['calibrated']; e.step(1,0,0,0,'img')
+    s+=str(int(c))
+    if not c: blocked.append(round(math.degrees(th),1))
+print(s); print(blocked)
diff --git a/probe_vis_j.py b/probe_vis_j.py
new file mode 100644
index 0000000..289f004
--- /dev/null
+++ b/probe_vis_j.py
@@ -0,0 +1,14 @@
+from probe_vis_lib import *
+import sys, json
+th=float(sys.argv[1]); y=float(sys.argv[2])
+e=E(4)
+e.path(1,[(-1.0,-1.0),(-1.0,y),(-2.3,y)]); e.turn(1,th)
+res=[]
+x=-2.3
+while x<-1.55:
+    ok=e.goto(1,x,y,tol=1e-7); st=e.rs(1)
+    if ok:
+        e.step(1,0,0,0,'cal'); c=e.rs(1)['calibrated']; e.step(1,0,0,0,'img'); res.append((st['x'],st['y'],st['theta'],int(c)))
+    x+=0.005
+json.dump(res,open('probe_vis_j_%s_%s.json'%(sys.argv[1],sys.argv[2]),'w'))
+s=''.join(str(r[3]) for r in res); print(th, res[0][0], s)
