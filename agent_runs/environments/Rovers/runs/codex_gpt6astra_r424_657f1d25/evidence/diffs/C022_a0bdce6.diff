diff --git a/inspect_collision.py b/inspect_collision.py
new file mode 100644
index 0000000..22be539
--- /dev/null
+++ b/inspect_collision.py
@@ -0,0 +1,14 @@
+import sys,numpy as np
+from env_client import make_env
+from approach import GeneratedApproach
+E=make_env();s,i=E.reset(seed=int(sys.argv[1]));A=GeneratedApproach(E.action_space,E.observation_space,{});A.reset(s,i)
+for t in range(100):
+ a=A.get_action(s);ss,_,done,tr,_=E.step(a)
+ for r,rob in enumerate(A.rovers):
+  p=A.xy(s,rob);q=p+a[r*4:r*4+2]
+  if np.linalg.norm(q-p)>.01 and np.linalg.norm(A.xy(ss,rob)-p)<1e-5:
+   print('COLLISION',t,r,'from',p,'to',q,'task',A.tasks[r])
+   print('nearest',sorted([(float(np.linalg.norm(np.maximum(np.maximum(lo-q,q-hi),0))),lo.tolist(),hi.tolist()) for lo,hi in A.rects])[:3])
+ s=ss
+ if done:break
+E.close()
diff --git a/probe_pillar.py b/probe_pillar.py
new file mode 100644
index 0000000..9e7e3f4
--- /dev/null
+++ b/probe_pillar.py
@@ -0,0 +1,40 @@
+from env_client import make_env
+import numpy as np
+
+def p(s):
+ o=s.get_object_from_name('rover0');return np.array([s.get(o,'x'),s.get(o,'y')])
+def st(e,s,d):
+ a=np.zeros(8);a[:2]=d;t,*_=e.step(a);return t
+
+def go(e,s,target):
+ for _ in range(60):
+  d=np.clip(np.array(target)-p(s),-.1,.1)
+  if np.linalg.norm(d)<1e-5:break
+  old=p(s);s=st(e,s,d)
+  if np.allclose(old,p(s)): print('STUCK',p(s),'towards',target);break
+ return s
+for mode in ['diag','left','front','right']:
+ e=make_env();s,_=e.reset(seed=60)
+ if mode=='diag':
+  for o in s.get_objects(e.observation_space.get_type('obstacle')):
+   print(str(o),[s.get(o,f) for f in ['x','y','half_x','half_y']])
+  s=go(e,s,[1.,.4]);s=go(e,s,[1.5,.2]);print('start',p(s));s=st(e,s,[-.2,-.2]);print('diag',p(s))
+ elif mode=='front':
+  s=go(e,s,[1.,.4]);s=go(e,s,[1.45038712,.4])
+  for _ in range(500):
+   old=p(s);s=st(e,s,[0,-.001])
+   if np.allclose(old,p(s)):break
+  print(mode,p(s))
+ elif mode=='right':
+  s=go(e,s,[2.,-1.75]);s=go(e,s,[2.,-.21976596])
+  for _ in range(600):
+   old=p(s);s=st(e,s,[-.001,0])
+   if np.allclose(old,p(s)):break
+  print(mode,p(s))
+ elif mode=='left':
+  s=go(e,s,[1.,.4]);s=go(e,s,[1.30000012,.4])
+  for _ in range(500):
+   old=p(s);s=st(e,s,[0,-.001])
+   if np.allclose(old,p(s)):break
+  print(mode,p(s))
+ e.close()
