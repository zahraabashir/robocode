diff --git a/probe_dynamic_radio.py b/probe_dynamic_radio.py
new file mode 100644
index 0000000..ac087e9
--- /dev/null
+++ b/probe_dynamic_radio.py
@@ -0,0 +1,21 @@
+from env_client import make_env
+from approach import GeneratedApproach
+import numpy as np
+for seed in [1212,549]:
+ e=make_env();s,i=e.reset(seed=seed,options={'object_count':4});a=GeneratedApproach(e.action_space,e.observation_space,{});a.reset(s,i)
+ def p(r):return a.xy(s,a.rovers[r])
+ def pending():return [(str(o),f) for o,f in a.radio_evidence(s,0)]
+ for t in range(180):
+  ev=a.radio_evidence(s,0);act=a.get_action(s);s,*_=e.step(act)
+  if act[3]>.4 and act[3]<.6 and ev:
+   success=any(s.get(o,f)>.5 for o,f in ev)
+   print(seed,t,'send',p(0),p(1),success,'pending',pending(),flush=True)
+   if t>22 and not success and s.get(a.rovers[1],'at_home')>.5:break
+ else:e.close();continue
+ for dest in [(-1,-1.51),(-1,-1),(-.6,-1),(-1,-1.75)]:
+  for k in range(20):
+   d=np.clip(np.array(dest)-p(1),-.2,.2);act=np.zeros(8);act[3]=.5;act[4:6]=d
+   s,*_=e.step(act)
+   print(seed,'intervene',p(0),p(1),'pending',pending(),flush=True)
+   if np.max(np.abs(d))<.005:break
+ e.close()
