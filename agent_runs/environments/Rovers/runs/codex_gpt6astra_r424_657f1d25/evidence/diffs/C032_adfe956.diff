+for t in range(180):
+ ac=A.get_action(s)
+ if t<30 or t%10==0:print(t,[A.xy(s,r).round(3).tolist() for r in A.rovers],A.tasks,ac[[3,7]].round(2).tolist(),'good',[[p.round(3).tolist() for p in ps] for ps in A.good_radio],flush=True)
+ s,_,term,tr,_=E.step(ac)
+ if term:break
+E.close()
