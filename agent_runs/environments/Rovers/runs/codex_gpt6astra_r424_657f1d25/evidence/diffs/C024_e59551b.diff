+from env_client import make_env
+import numpy as np
+for dx in [-.3,-.27,-.25,-.23,-.21,-.18,-.15,-.1,-.05,0,.05,.10,.15]:
+ e=make_env();s,_=e.reset(seed=60);o=s.get_object_from_name('rover0')
+ def p():return np.array([s.get(o,'x'),s.get(o,'y')])
+ def st(d):
+  global s
+  a=np.zeros(8);a[:2]=d;s,*_=e.step(a)
+ for target in [[1.,.4],[1.45038712+dx,.4],[1.45038712+dx,.1]]:
+  for k in range(40):
+   d=np.clip(np.array(target)-p(),-.2,.2)
+   if np.linalg.norm(d)<1e-5:break
+   old=p();st(d)
+   if np.allclose(old,p()):break
+ for k in range(50):
+  old=p();st([0,-.01])
+  if np.allclose(old,p()):break
+ print(dx,p(),flush=True)
+ e.close()
