diff --git a/probe_pillar_axis.py b/probe_pillar_axis.py
new file mode 100644
index 0000000..4e53ca6
--- /dev/null
+++ b/probe_pillar_axis.py
@@ -0,0 +1,19 @@
+from env_client import make_env
+import numpy as np
+for dy in [-.27,-.24,-.2,-.1,0,.1,.2,.24,.27]:
+ e=make_env();s,_=e.reset(seed=60);o=s.get_object_from_name('rover0')
+ def p():return np.array([s.get(o,'x'),s.get(o,'y')])
+ def st(d):
+  global s
+  a=np.zeros(8);a[:2]=d;s,*_=e.step(a)
+ for target in [[1.,-.21976596+dy],[1.15,-.21976596+dy]]:
+  for k in range(40):
+   d=np.clip(np.array(target)-p(),-.2,.2)
+   if np.linalg.norm(d)<1e-5:break
+   old=p();st(d)
+   if np.allclose(old,p()):break
+ for k in range(40):
+  old=p();st([.005,0])
+  if np.allclose(old,p()):break
+ print(dy,p(),flush=True)
+ e.close()
