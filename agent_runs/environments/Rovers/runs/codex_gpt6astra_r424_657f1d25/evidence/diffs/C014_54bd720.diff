diff --git a/probe_lander_exact.py b/probe_lander_exact.py
new file mode 100644
index 0000000..5b438da
--- /dev/null
+++ b/probe_lander_exact.py
@@ -0,0 +1,19 @@
+from env_client import make_env
+import numpy as np
+for mode in ['front','side']:
+ e=make_env();s,_=e.reset(seed=29);o=s.get_object_from_name('rover1')
+ def p():return np.array([s.get(o,'x'),s.get(o,'y')])
+ def st(d):
+  global s
+  a=np.zeros(8);a[4:6]=d;s,*_=e.step(a)
+ targets=[[-1,-1],[-1.9,-1],[-1.9,-1.46]] if mode=='front' else [[-1.19,-1.75]]
+ for target in targets:
+  for k in range(50):
+   d=np.clip(np.array(target)-p(),-.1,.1)
+   if np.linalg.norm(d)<1e-6:break
+   st(d)
+ for k in range(100):
+  old=p();st([0,-.0001] if mode=='front' else [-.0001,0])
+  if np.allclose(p(),old,atol=1e-7,rtol=0):break
+ print(mode,p(),k)
+ e.close()
diff --git a/probe_send_distance.py b/probe_send_distance.py
new file mode 100644
index 0000000..ca8481c
--- /dev/null
+++ b/probe_send_distance.py
@@ -0,0 +1,13 @@
+import numpy as np
+from env_client import make_env
+from probe_policy_old import GeneratedApproach
+for pt in [(1.4,0),(1.3,.2),(1.39,.1),(1.38,.1),(1.37,.1),(1.36,.1)]:
+ e=make_env();s,info=e.reset(seed=3);p=GeneratedApproach(e.action_space,e.observation_space,{});p.reset(s,info)
+ for _ in range(55):s,*_=e.step(p.get_action(s))
+ a=np.zeros(8,np.float32);a[:2]=np.array(pt)-p.xy(s,p.rovers[0]);a[3]=.5;s,*_=e.step(a)
+ print(pt,'dist',np.linalg.norm(np.array(pt)-p.lander),'pending',p.pending(s,0))
+ if pt==(1.4,0):
+  x=np.array([1.4,.1]);d=p.lander-x
+  for o in p.objects(s,'obstacle'):
+   q=p.xy(s,o);u=np.clip(np.dot(q-x,d)/np.dot(d,d),0,1);print(o.name,q,'dist',np.linalg.norm(q-x-u*d),'half',s.get(o,'half_x'),s.get(o,'half_z'))
+ e.close()
