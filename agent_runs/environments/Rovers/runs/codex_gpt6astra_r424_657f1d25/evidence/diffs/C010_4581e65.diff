diff --git a/probe_los_threshold.py b/probe_los_threshold.py
new file mode 100644
index 0000000..a9d4f7b
--- /dev/null
+++ b/probe_los_threshold.py
@@ -0,0 +1,18 @@
+import numpy as np
+from env_client import make_env
+from approach import GeneratedApproach
+for seed,rr,points in [(4,1,[(-1.8,0),(-1.75,0),(-1.7,0),(-1.65,0),(-1.6,0)]),(3,0,[(1.4,.1),(1.3,.1),(1.3,.2),(1.2,.1)])]:
+ for pt in points:
+  e=make_env();s,info=e.reset(seed=seed);p=GeneratedApproach(e.action_space,e.observation_space,{});p.reset(s,info)
+  for t in range(55):s,*_=e.step(p.get_action(s))
+  rob=p.rovers[rr]
+  for t in range(6):
+   a=np.zeros(8,np.float32);a[rr*4:rr*4+2]=np.clip(np.array(pt)-p.xy(s,rob),-.2,.2);a[rr*4+3]=-.5 if seed==4 else .5;s,*_=e.step(a)
+  target=p.xy(s,p.objectives[2]) if seed==4 else p.lander
+  start=p.xy(s,rob);d=target-start
+  distances=[]
+  for ob in p.objects(s,'obstacle')+p.rovers:
+   if ob==rob:continue
+   q=p.xy(s,ob);u=np.clip(np.dot(q-start,d)/np.dot(d,d),0,1);distances.append((round(np.linalg.norm(q-start-u*d),3),ob.name))
+  print(seed,pt,'cal',s.get(rob,'calibrated'),'pending',p.pending(s,rr),'near',sorted(distances)[:4])
+  e.close()
