diff --git a/probe_motion.py b/probe_motion.py
new file mode 100644
index 0000000..d6c986d
--- /dev/null
+++ b/probe_motion.py
@@ -0,0 +1,28 @@
+from env_client import make_env
+import numpy as np
+
+def vals(s,n='rover0'):
+ o=s.get_object_from_name(n);return [s.get(o,f) for f in ['x','y','theta','at_home']]
+def step(e,dx=0,dy=0,dt=0):
+ a=np.zeros(8);a[:3]=[dx,dy,dt];t,*_=e.step(a);return t
+for y in [-2.30,-2.25,-2.2,-2,-1.5,-1,-.5,0,.5,1,1.5,1.75,2,2.25,2.3]:
+ e=make_env();s,_=e.reset(seed=0)
+ while abs(vals(s)[1]-y)>.001:
+  old=vals(s);s=step(e,dy=np.clip(y-old[1],-.2,.2))
+  if vals(s)==old:break
+ for _ in range(20):
+  old=vals(s);s=step(e,dx=-.05)
+  if vals(s)==old:break
+ print('wall scan',y,vals(s))
+ e.close()
+for mode in ['east','south','wall','home']:
+ e=make_env();s,_=e.reset(seed=0)
+ for k in range(160):
+  old=vals(s)
+  if mode=='east':s=step(e,dx=.01)
+  if mode=='south':s=step(e,dy=-.01)
+  if mode=='wall':s=step(e,dx=-.01)
+  if mode=='home':s=step(e,dx=.01)
+  if vals(s)==old or (mode=='home' and vals(s)[-1]==0):break
+ print('exact',mode,vals(s),k)
+ e.close()
