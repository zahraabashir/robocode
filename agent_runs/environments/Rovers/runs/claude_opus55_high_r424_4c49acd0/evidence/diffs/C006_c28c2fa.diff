diff --git a/cache_states.py b/cache_states.py
new file mode 100644
index 0000000..2bc9635
--- /dev/null
+++ b/cache_states.py
@@ -0,0 +1,15 @@
+import json, sys
+from concurrent.futures import ThreadPoolExecutor
+from env_client import make_env
+def get(seed):
+    env=make_env(); obs,info=env.reset(seed=seed)
+    out={'info':info,'objs':{}}
+    for n in obs.get_object_names():
+        o=obs.get_object_from_name(n)
+        feats=env.observation_space.type_features[o.type] if o.type in env.observation_space.type_features else None
+        out['objs'][n]={'type':o.type.name,'f':{f:float(obs.get(o,f)) for f in feats}}
+    env.close(); return seed,out
+with ThreadPoolExecutor(8) as ex:
+    res=dict(ex.map(get, range(int(sys.argv[1]), int(sys.argv[2]))))
+json.dump(res, open(f'states_{sys.argv[1]}_{sys.argv[2]}.json','w'))
+print(len(res))
diff --git a/offline.py b/offline.py
new file mode 100644
index 0000000..07521b9
--- /dev/null
+++ b/offline.py
@@ -0,0 +1,32 @@
+import json, sys, time
+from concurrent.futures import ProcessPoolExecutor
+class T:
+    def __init__(s,n): s.name=n
+class O:
+    def __init__(s,n,t): s.name=n; s.type=T(t)
+class FakeState:
+    def __init__(s,objs): s.objs=objs; s.o={n:O(n,v['type']) for n,v in objs.items()}
+    def get_object_names(s): return set(s.objs)
+    def get_object_from_name(s,n): return s.o[n]
+    def get(s,o,f): return s.objs[o.name]['f'][f]
+def run(args):
+    seed, st = args
+    import approach
+    ap=approach.GeneratedApproach(None,None,{})
+    t=time.time()
+    ap.reset(FakeState(st['objs']), st['info'])
+    tp=time.time()-t
+    from approach import parse
+    d=parse(FakeState(st['objs']))
+    steps=ap._simulate(d)
+    return seed, st['info'].get('object_count'), steps, ap.plan_cost, round(tp,2)
+if __name__=='__main__':
+    S=json.load(open(sys.argv[1]))
+    lo,hi=int(sys.argv[2]),int(sys.argv[3])
+    items=[(int(k),v) for k,v in S.items() if lo<=int(k)<hi]
+    with ProcessPoolExecutor(16) as ex:
+        res=list(ex.map(run, items))
+    res.sort()
+    if len(sys.argv)>4:
+        for r in res: print(*r)
+    print('TOTAL', sum(r[2] for r in res), 'N', len(res), 'maxt', max(r[4] for r in res))
diff --git a/pD_scan2.py b/pD_scan2.py
new file mode 100644
index 0000000..f03351f
--- /dev/null
+++ b/pD_scan2.py
@@ -0,0 +1,40 @@
+import sys, json
+from multiprocessing import Pool
+from pB_lib import *
+from pD_lib import pos_on_line
+IMG={2:(0.4,0.2),1:(1.0,0.3)}
+def image(s,k,S):
+    gp(s,0,[IMG[k]],th=np.pi); s.act(a0=(0,0,0,'cal')); s.act(a0=(0,0,0,'img'))
+    assert objf(s,k,'have_image_rover0')==1 and objf(s,k,'received_image')==0
+    assert gp(s,0,[(S[0],IMG[k][1]),(S[0],S[1])],th=S[2])
+def scanside(s,k,S,t,side,th,offs):
+    out=[]
+    for o in offs:
+        p=pos_on_line(S,t,side*o,th)
+        ok=s.goto(1,p[0],p[1],th=p[2]); r=s.r(1)
+        if not(ok and abs(r['x']-p[0])<2e-3 and abs(r['y']-p[1])<2e-3): out.append((o,None)); continue
+        s.act(a0=(0,0,0,'send'))
+        res=objf(s,k,'received_image')==1; out.append((o,res))
+        if res: break
+    return out
+def job(j):
+    S,t,th=j
+    try:
+        s=Sim(44); s.goto(1,-1.0,-0.3)
+        offs=list(np.round(np.arange(0,0.301,0.01),3))
+        image(s,2,S); a=scanside(s,2,S,t,+1,th,offs)
+        s.goto(1,-1.0,-0.3)
+        image(s,1,S); b=scanside(s,1,S,t,-1,th,offs)
+        return j,a,b
+    except Exception as e: return j,'ERR',repr(e)
+def summ(a):
+    if a=='ERR': return a
+    fails=[o for o,r in a if r is None]; succ=[o for o,r in a if r]
+    blocked=[o for o,r in a if r is False]
+    return 'first_free=%s lastblocked=%s placefail=%s'%(succ[0] if succ else None, blocked[-1] if blocked else None, fails[:3])
+if __name__=='__main__':
+    S=tuple(json.loads(sys.argv[1])); ths=json.loads(sys.argv[2]); ts=json.loads(sys.argv[3])
+    jobs=[(S,t,th) for th in ths for t in ts]
+    with Pool(int(sys.argv[4]) if len(sys.argv)>4 else 8) as p:
+        for j,a,b in p.imap(job,jobs):
+            print('t=%.2f th=%.2f | +side %s | -side %s'%(j[1],j[2],summ(a),summ(b) if a!='ERR' else b),flush=True)
